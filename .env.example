# ByteDance Volcengine Ark API
# Get your API Key from: https://console.volcengine.com/ark/region:ark+cn-beijing/apiKey
# IMPORTANT: Use the Ark API Key (starts with sk-), NOT your IAM Access Key
VOLC_API_KEY=

# Alibaba Cloud DashScope (International / Singapore region)
# Get your API Key from: https://www.alibabacloud.com/help/zh/model-studio/get-api-key
# Use the key starting with sk-ws-H.*
DASHSCOPE_API_KEY=

# OpenRouter (Image Generation via OpenRouter)
# Get your API Key from: https://openrouter.ai/keys
# Used by: gpt-image-2.0, nano-banana-2
OPENROUTER_API_KEY=
OPENROUTER_SITE_URL=
OPENROUTER_SITE_TITLE=

# OpenAI (legacy, not used for image generation)
# Default base URL points to the official OpenAI API.
# To use a relay/proxy (e.g. sg.uiuiapi.com), set OPENAI_BASE_URL accordingly.
# Note: do not commit real keys to git. .gitignore blocks this file.
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_API_KEY=your_openai_api_key

